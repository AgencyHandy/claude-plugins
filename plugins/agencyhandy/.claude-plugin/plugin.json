  "displayName": "Agency Handy",
  "version": "1.1.2",
  "description": "Work with your Agency Handy workspace from Claude Code: clients, leads, projects, tasks, tickets, invoices and proposals. Sending to clients and deleting always ask you first.",
  "author": {
    "name": "Agency Handy",
    "email": "support@agencyhandy.com",
    "url": "https://agencyhandy.com"
  },
  "homepage": "https://docs.agencyhandy.com",
  "keywords": [
    "agencyhandy",
    "crm",
    "agency",
    "invoices",
    "projects",
    "mcp"
  ],
  "userConfig": {
    "api_key": {
      "title": "Agency Handy API key",
