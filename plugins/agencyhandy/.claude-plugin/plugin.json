      "type": "string",
      "sensitive": true,
      "required": true
    }
  },
  "mcpServers": {
    "agencyhandy": {
      "type": "http",
      "url": "https://mcp.agencyhandy.com/",
      "headers": {
        "Authorization": "Bearer ${user_config.api_key}"
      }
    }
  },
